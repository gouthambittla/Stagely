datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int      @id @default(autoincrement())
  firebaseUid  String   @unique
  email        String?  @unique
  phone        String?  @unique
  name         String?
  venueName    String?
  city         String?
  contactPhone String?
  role         String // CUSTOMER, ARTIST, ADMIN
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  artistProfile    ArtistProfile?
  customerBookings Booking[]      @relation("CustomerBookings")
  sentMessages     Message[]      @relation("UserSentMessages")
  reviews          Review[]       @relation("CustomerReviews")
}

model ArtistProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistName         String
  category           String // Band, Solo Musician, Singer, Dancer, etc.
  genres             String // JSON string array of genres
  location           String // City (e.g., Hyderabad)
  baseFee            Int // In INR
  bio                String?
  requirements       String? // Stage & Sound technical requirements
  youtubeUrl         String?
  instagramUrl       String?
  verificationStatus String   @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, VERIFIED, REJECTED
  // Payouts (Razorpay Route linked account). Raw bank account numbers and PAN are never stored.
  payoutAccountId    String? // acc_xxx
  payoutStatus       String   @default("NOT_STARTED") // NOT_STARTED, PENDING, ACTIVE, REJECTED
  payoutLegalName    String?
  payoutIfsc         String?
  payoutAccountLast4 String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  availabilitySlots AvailabilitySlot[]
  bookings          Booking[]          @relation("ArtistBookings")
  reviews           Review[]           @relation("ArtistReviews")

  @@index([verificationStatus, createdAt])
}

model AvailabilitySlot {
  id        Int           @id @default(autoincrement())
  artistId  Int
  artist    ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  startTime String // HH:mm
  endTime   String // HH:mm
  isBooked  Boolean       @default(false)
  createdAt DateTime      @default(now())

  bookings Booking[]

  @@unique([artistId, date, startTime])
}

model Booking {
  id                 Int              @id @default(autoincrement())
  customerId         Int
  customer           User             @relation("CustomerBookings", fields: [customerId], references: [id])
  artistId           Int
  artist             ArtistProfile    @relation("ArtistBookings", fields: [artistId], references: [id])
  slotId             Int
  slot               AvailabilitySlot @relation(fields: [slotId], references: [id])
  eventType          String
  eventLocation      String
  status             String           @default("REQUESTED") // see BookingStatus in src/types (ACCEPTED -> COMPLETED by booker or 48h after eventEndsAt)
  notes              String?
  expiresAt          DateTime? // REQUESTED offers auto-expire (and release the slot) after this instant
  eventEndsAt        DateTime? // slot date + endTime (IST), computed once at request time
  completedAt        DateTime?
  amountPaise        Int? // fee locked when the booker requests (artist.baseFee * 100)
  paymentDueAt       DateTime? // AWAITING_PAYMENT deadline
  cancelledAt        DateTime?
  cancellationReason String?
  disputedAt         DateTime?
  disputeReason      String?
  resolution         String? // admin ruling on a dispute: PAY_ARTIST, REFUND, SPLIT
  resolvedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  messages Message[]
  review   Review?
  payment  Payment?

  @@index([customerId, createdAt])
  @@index([artistId, status])
  @@index([slotId, status])
  @@index([status, expiresAt])
  @@index([status, eventEndsAt])
  @@index([status, paymentDueAt])
}

model Payment {
  id                Int      @id @default(autoincrement())
  bookingId         Int      @unique
  // Money records must never disappear with their booking
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  gatewayOrderId    String   @unique // order_xxx
  gatewayPaymentId  String?  @unique // pay_xxx
  gatewayTransferId String? // trf_xxx (artist share, on hold)
  amountPaise       Int // total the booker pays
  artistSharePaise  Int
  platformFeePaise  Int
  status            String // CREATED, CAPTURED, RELEASED, REFUNDED, PARTIALLY_REFUNDED, FAILED
  refundedPaise     Int      @default(0)
  // What the booker is owed back once settled (set by cancellation or dispute ruling). Settlement
  // reconciles Razorpay towards this; the artist gets the rest minus the proportional fee.
  refundTargetPaise Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Webhook idempotency + audit trail
model PaymentEvent {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique // Razorpay x-razorpay-event-id
  type        String
  payload     Json
  processedAt DateTime @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  bookingId Int
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User     @relation("UserSentMessages", fields: [senderId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

model Review {
  id         Int           @id @default(autoincrement())
  bookingId  Int           @unique
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  artistId   Int
  artist     ArtistProfile @relation("ArtistReviews", fields: [artistId], references: [id], onDelete: Cascade)
  customerId Int
  customer   User          @relation("CustomerReviews", fields: [customerId], references: [id])
  rating     Int // 1 to 5 integer
  comment    String?
  tags       String? // JSON string array e.g. ["Punctual", "Great Sound"]
  createdAt  DateTime      @default(now())

  @@index([artistId, createdAt])
}
