# --- Runtime ---
# development | test | production  (production disables mock auth unconditionally)
NODE_ENV=development
PORT=5000

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/stagely?schema=public"

# --- Firebase Admin (token verification) ---
# Production: one of these is required. Service account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# --- Local development only ---
# Accept mock_* tokens from the Expo Go auth simulator. Never set in production
# (the server refuses to start if NODE_ENV=production and this is true).
ALLOW_MOCK_AUTH=true

# --- HTTP ---
# Comma-separated browser origins allowed by CORS (native apps send no Origin). Unset = allow all.
CORS_ORIGINS=
# Number of reverse-proxy hops in front of the API (e.g. 1 behind a load balancer).
TRUST_PROXY=0
