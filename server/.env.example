# --- Runtime ---
# development | test | production  (production disables mock auth unconditionally)
NODE_ENV=development
PORT=5000

# --- Database ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/stagely?schema=public"

# --- Firebase Admin (token verification) ---
# Production: one of these is required. Service account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# --- Local development only ---
# Accept mock_* tokens from the Expo Go auth simulator. Never set in production
# (the server refuses to start if NODE_ENV=production and this is true).
ALLOW_MOCK_AUTH=true

# --- HTTP ---
# Comma-separated browser origins allowed by CORS (native apps send no Origin). Unset = allow all.
CORS_ORIGINS=
# Number of reverse-proxy hops in front of the API (e.g. 1 behind a load balancer).
TRUST_PROXY=0

# --- Payments (Razorpay Route escrow) ---
# Off by default: accepted bookings stay ACCEPTED and are settled offline.
# In production with payments on, the three Razorpay values and PUBLIC_BASE_URL are required.
# Without keys outside production, an in-memory fake gateway is used.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stagely's commission (%), payment window after accept, and post-event dispute window
PLATFORM_FEE_PERCENT=10
PAYMENT_WINDOW_HOURS=24
DISPUTE_WINDOW_HOURS=48
# Public origin of this API; used to build the hosted checkout link
PUBLIC_BASE_URL=
# Optional: Razorpay profile category/subcategory for artist linked accounts (verify in Test Mode)
RAZORPAY_ROUTE_CATEGORY=
RAZORPAY_ROUTE_SUBCATEGORY=
